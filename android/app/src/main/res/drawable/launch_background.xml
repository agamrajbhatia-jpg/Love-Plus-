<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Immersive dark-to-rose romantic gradient background -->
    <item>
        <shape>
            <gradient
                android:startColor="#1A020B"
                android:centerColor="#3B071A"
                android:endColor="#0F0106"
                android:angle="90"
                android:type="linear" />
        </shape>
    </item>

    <!-- Centered Logo -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launcher_icon" />
    </item>
</layer-list>
